# Copy to .env locally. Never commit real values.
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_MODEL=grok-4-1-fast
# XAI_API_BASE=https://api.x.ai/v1
# STAMP_API_KEY=
# ALLOW_KEYWORD_ATTESTATION=0
# AUDIT_SYSTEM_PROMPT=
# PRIVATE_KEY=
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# CORE_TIMELOCK=   # required for Deploy.s.sol and DeployBotAttestationEscrow.s.sol — timelock/multisig, not the deployer
# DENYLIST=        # required for script/DeployBotAttestationEscrow.s.sol — from the core broadcast
# VAULT=           # required for script/DeployBotAttestationEscrow.s.sol
# DISPUTE_PANEL=   # required for script/DeployBotAttestationEscrow.s.sol and script/OpsDisputePanel.s.sol
# Gate B (script/DEPLOY_ESCROW_BASE_SEPOLIA.md). Spencer picks the seats. Placeholders are not live.
# ARBITRATOR=      # OpsDisputePanelAdd / OpsDisputePanelRemove
# ARBITRATOR_1=
# ARBITRATOR_2=
# ARBITRATOR_3=    # OpsDisputePanelSeat — three distinct addresses. PRIVATE_KEY only if Spencer broadcasts.
# BVT_GUARDIAN=    # required for script/DeployBVT.s.sol — non-deployer multisig
# BVT_INSURANCE_SINK=
# BVT_TREASURY=
# Live Denylist + Vault ops (script/OPS_LIVE_DENYLIST_VAULT.md).
# Addresses come from deployments/base-sepolia.json. PRIVATE_KEY only if Spencer broadcasts.
# LISTING_ID=      # bytes32 for script/OpsDenylist.s.sol
# BUCKET=          # Exact, Signature, or Prompt — OpsDenylistRemove
# BOT_ID=
# WEIGHT_HASH=
# BEHAVIOR_SIG=
# PROMPT_HASH=
# TIER=            # None, Chat, DataTools, Financial, or Critical
# OPERATOR=        # OpsVaultRegisterWithOperator only
