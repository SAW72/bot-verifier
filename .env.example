# Copy to .env locally. Never commit real values.
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_MODEL=grok-4-1-fast
# XAI_API_BASE=https://api.x.ai/v1
# STAMP_API_KEY=
# ALLOW_KEYWORD_ATTESTATION=0
# AUDIT_SYSTEM_PROMPT=
# PRIVATE_KEY=
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# CORE_TIMELOCK=   # required for Deploy.s.sol, DeployDenylist.s.sol, DeployBotAttestationEscrow.s.sol, and MigrateDenylistListings.s.sol — timelock/multisig, not the deployer
# NEW_DENYLIST=    # MigrateDenylistListings.s.sol — new tip Denylist from the DeployDenylist broadcast
# OLD_DENYLIST=    # MigrateDenylistListings.s.sol — read-only source; live pre-PR #10 Denylist is 0xF0f260967D377E07Bdd7840862508ddB23C012b8
# MIGRATION_FILE=  # MigrateDenylistListings.s.sol — JSON { "exact": [], "signature": [], "prompt": [] }; start from script/denylist-migration.template.json
# DENYLIST=        # required for script/DeployBotAttestationEscrow.s.sol — from the core broadcast
# VAULT=           # required for script/DeployBotAttestationEscrow.s.sol
# DISPUTE_PANEL=   # required for script/DeployBotAttestationEscrow.s.sol
# BVT_GUARDIAN=    # required for script/DeployBVT.s.sol — non-deployer multisig
# BVT_INSURANCE_SINK=
# BVT_TREASURY=
